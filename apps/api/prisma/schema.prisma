generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SaasPlan {
  id            String   @id @db.Uuid
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(120)
  price         Decimal  @db.Decimal(19, 4)
  billingPeriod String   @map("billing_period") @db.VarChar(20)
  userLimit     Int      @map("user_limit")
  branchLimit   Int      @map("branch_limit")
  active        Boolean
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@map("saas_plans")
}

model SaasModule {
  id        String   @id @db.Uuid
  code      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(120)
  active    Boolean
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  @@map("saas_modules")
}

model PlanModule {
  id        String   @id @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  @@unique([planId, moduleId])
  @@map("plan_modules")
}

model Subscription {
  id                 String    @id @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  status             String    @db.VarChar(20)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz
  blockedAt          DateTime? @map("blocked_at") @db.Timestamptz
  createdAt          DateTime  @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz

  @@map("subscriptions")
}

model SubscriptionModule {
  id             String   @id @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  moduleId       String   @map("module_id") @db.Uuid
  enabled        Boolean
  createdAt      DateTime @map("created_at") @db.Timestamptz
  updatedAt      DateTime @map("updated_at") @db.Timestamptz

  @@unique([subscriptionId, moduleId])
  @@map("subscription_modules")
}

model Company {
  id        String    @id @db.Uuid
  legalName String    @map("legal_name") @db.VarChar(200)
  tradeName String?   @map("trade_name") @db.VarChar(200)
  taxId     String    @unique @map("tax_id") @db.VarChar(14)
  status    String    @db.VarChar(20)
  timezone  String    @db.VarChar(80)
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("companies")
}

model Branch {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String    @db.VarChar(40)
  legalName String    @map("legal_name") @db.VarChar(200)
  tradeName String?   @map("trade_name") @db.VarChar(200)
  taxId     String    @map("tax_id") @db.VarChar(14)
  status    String    @db.VarChar(20)
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, code])
  @@unique([companyId, taxId])
  @@unique([id, companyId])
  @@map("branches")
}

model User {
  id                String    @id @db.Uuid
  email             String    @unique @db.VarChar(254)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  displayName       String    @map("display_name") @db.VarChar(160)
  status            String    @db.VarChar(20)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz
  mfaEnabled        Boolean   @map("mfa_enabled")
  createdAt         DateTime  @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  @@map("users")
}

model CompanyUser {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @db.VarChar(20)
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  @@unique([companyId, userId])
  @@unique([id, companyId])
  @@map("company_users")
}

model UserBranch {
  id            String   @id @db.Uuid
  companyUserId String   @map("company_user_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@unique([companyUserId, branchId])
  @@map("user_branches")
}

model Role {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String    @db.VarChar(80)
  name      String    @db.VarChar(120)
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("roles")
}

model Permission {
  id        String   @id @db.Uuid
  code      String   @unique @db.VarChar(120)
  resource  String   @db.VarChar(80)
  action    String   @db.VarChar(40)
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  @@map("permissions")
}

model RolePermission {
  id           String   @id @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @map("created_at") @db.Timestamptz
  updatedAt    DateTime @map("updated_at") @db.Timestamptz

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id            String   @id @db.Uuid
  companyUserId String   @map("company_user_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@unique([companyUserId, roleId])
  @@map("user_roles")
}

model UserPermission {
  id            String   @id @db.Uuid
  companyUserId String   @map("company_user_id") @db.Uuid
  permissionId  String   @map("permission_id") @db.Uuid
  allowed       Boolean
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@unique([companyUserId, permissionId])
  @@map("user_permissions")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  ip               String?   @db.Inet
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz

  @@map("sessions")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(120)
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  attempts      Int
  createdAt     DateTime  @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz

  @@map("outbox_events")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz

  @@map("password_reset_tokens")
}

model AuditLog {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String   @db.VarChar(80)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.Uuid
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  ip            String?  @db.Inet
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@map("audit_logs")
}

model LoginAttempt {
  id            String   @id @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  emailHash     String   @map("email_hash") @db.Char(64)
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(60)
  ip            String?  @db.Inet
  userAgent     String?  @map("user_agent")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@map("login_attempts")
}

model Employee {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  code      String    @db.VarChar(40)
  name      String    @db.VarChar(160)
  taxId     String?   @map("tax_id") @db.VarChar(14)
  jobTitle  String?   @map("job_title") @db.VarChar(100)
  active    Boolean
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("employees")
}

model Address {
  id         String   @id @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  postalCode String?  @map("postal_code") @db.VarChar(8)
  street     String   @db.VarChar(180)
  number     String?  @db.VarChar(30)
  complement String?  @db.VarChar(120)
  district   String?  @db.VarChar(120)
  city       String   @db.VarChar(120)
  state      String   @db.Char(2)
  country    String   @db.Char(2)
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  createdAt  DateTime @map("created_at") @db.Timestamptz
  updatedAt  DateTime @map("updated_at") @db.Timestamptz

  @@map("addresses")
}

model Customer {
  id          String    @id @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  personType  String    @map("person_type") @db.Char(1)
  taxId       String?   @map("tax_id") @db.VarChar(14)
  legalName   String    @map("legal_name") @db.VarChar(200)
  tradeName   String?   @map("trade_name") @db.VarChar(200)
  phone       String?   @db.VarChar(30)
  whatsapp    String?   @db.VarChar(30)
  email       String?   @db.VarChar(254)
  creditLimit Decimal   @map("credit_limit") @db.Decimal(19, 4)
  notes       String?
  active      Boolean
  createdAt   DateTime  @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, taxId])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  addressId  String   @map("address_id") @db.Uuid
  type       String   @db.VarChar(20)
  isDefault  Boolean  @map("is_default")
  createdAt  DateTime @map("created_at") @db.Timestamptz
  updatedAt  DateTime @map("updated_at") @db.Timestamptz

  @@unique([customerId, addressId, type])
  @@map("customer_addresses")
}

model Supplier {
  id              String    @id @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  taxId           String?   @map("tax_id") @db.VarChar(14)
  legalName       String    @map("legal_name") @db.VarChar(200)
  tradeName       String?   @map("trade_name") @db.VarChar(200)
  email           String?   @db.VarChar(254)
  phone           String?   @db.VarChar(30)
  averageLeadDays Int?      @map("average_lead_days")
  paymentTerms    String?   @map("payment_terms")
  active          Boolean
  createdAt       DateTime  @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, taxId])
  @@map("suppliers")
}

model SupplierProduct {
  id                  String   @id @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  supplierId          String   @map("supplier_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  supplierCode        String?  @map("supplier_code") @db.VarChar(80)
  supplierDescription String?  @map("supplier_description") @db.VarChar(240)
  lastPrice           Decimal? @map("last_price") @db.Decimal(19, 4)
  createdAt           DateTime @map("created_at") @db.Timestamptz
  updatedAt           DateTime @map("updated_at") @db.Timestamptz

  @@unique([supplierId, productId])
  @@index([companyId, supplierId])
  @@index([companyId, productId, lastPrice])
  @@map("supplier_products")
}

model ProductGroup {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(120)
  active    Boolean
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, name])
  @@map("product_groups")
}

model ProductCategory {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @db.VarChar(120)
  active    Boolean
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, parentId, name])
  @@map("product_categories")
}

model Brand {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(120)
  active    Boolean
  createdAt DateTime  @map("created_at") @db.Timestamptz
  updatedAt DateTime  @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, name])
  @@map("brands")
}

model Unit {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  code          String   @db.VarChar(12)
  name          String   @db.VarChar(80)
  decimalPlaces Int      @map("decimal_places") @db.SmallInt
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@unique([companyId, code])
  @@map("units")
}

model Product {
  id                  String    @id @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  code                String    @db.VarChar(60)
  barcode             String?   @db.VarChar(30)
  description         String    @db.VarChar(240)
  shortDescription    String?   @map("short_description") @db.VarChar(120)
  groupId             String?   @map("group_id") @db.Uuid
  categoryId          String?   @map("category_id") @db.Uuid
  brandId             String?   @map("brand_id") @db.Uuid
  unitId              String    @map("unit_id") @db.Uuid
  reference           String?   @db.VarChar(80)
  productType         String    @map("product_type") @db.VarChar(20)
  controlsLot         Boolean   @map("controls_lot")
  controlsExpiry      Boolean   @map("controls_expiry")
  selectLotAtPos      Boolean   @default(false) @map("select_lot_at_pos")
  allowsNegativeStock Boolean   @map("allows_negative_stock")
  openPrice           Boolean   @map("open_price")
  imageStorageKey     String?   @map("image_storage_key")
  ncm                 String?   @db.VarChar(8)
  cest                String?   @db.VarChar(7)
  origin              String?   @db.VarChar(1)
  cfop                String?   @db.VarChar(4)
  cst                 String?   @db.VarChar(3)
  csosn               String?   @db.VarChar(3)
  taxProfile          Json?     @map("tax_profile")
  deliveryEnabled     Boolean   @map("delivery_enabled")
  deliveryName        String?   @map("delivery_name") @db.VarChar(160)
  deliveryDescription String?   @map("delivery_description")
  deliveryPrice       Decimal?  @map("delivery_price") @db.Decimal(19, 4)
  printSector         String?   @map("print_sector") @db.VarChar(40)
  active              Boolean
  createdAt           DateTime  @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@map("products")
}

model ProductBranchSetting {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  minimumStock  Decimal  @map("minimum_stock") @db.Decimal(19, 6)
  maximumStock  Decimal? @map("maximum_stock") @db.Decimal(19, 6)
  locationLabel String?  @map("location_label") @db.VarChar(100)
  active        Boolean
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@unique([branchId, productId])
  @@map("product_branch_settings")
}

model Warehouse {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  @@unique([branchId, code])
  @@unique([id, companyId])
  @@map("warehouses")
}

model StockLocation {
  id          String   @id @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String   @db.VarChar(60)
  name        String   @db.VarChar(120)
  createdAt   DateTime @map("created_at") @db.Timestamptz
  updatedAt   DateTime @map("updated_at") @db.Timestamptz

  @@unique([warehouseId, code])
  @@unique([id, companyId])
  @@map("stock_locations")
}

model StockLot {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  lotNumber      String    @map("lot_number") @db.VarChar(80)
  manufacturedAt DateTime? @map("manufactured_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  sourceType     String?   @map("source_type") @db.VarChar(40)
  sourceId       String?   @map("source_id") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz

  @@unique([companyId, productId, lotNumber])
  @@unique([id, companyId])
  @@map("stock_lots")
}

model StockBalance {
  id               String   @id @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  lotId            String?  @map("lot_id") @db.Uuid
  quantity         Decimal  @db.Decimal(19, 6)
  reservedQuantity Decimal  @map("reserved_quantity") @db.Decimal(19, 6)
  version          Int
  createdAt        DateTime @map("created_at") @db.Timestamptz
  updatedAt        DateTime @map("updated_at") @db.Timestamptz

  @@index([companyId, branchId, productId])
  @@map("stock_balances")
}

model StockMovement {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  lotId         String?  @map("lot_id") @db.Uuid
  movementType  String   @map("movement_type") @db.VarChar(30)
  quantity      Decimal  @db.Decimal(19, 6)
  unitCost      Decimal? @map("unit_cost") @db.Decimal(19, 4)
  referenceType String   @map("reference_type") @db.VarChar(40)
  referenceId   String   @map("reference_id") @db.Uuid
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz
  updatedAt     DateTime @map("updated_at") @db.Timestamptz

  @@index([companyId, branchId, productId, occurredAt])
  @@map("stock_movements")
}

model SupplierInvoice {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  supplierId    String   @map("supplier_id") @db.Uuid
  accessKey     String   @map("access_key") @db.Char(44)
  number        String   @db.VarChar(20)
  series        String?  @db.VarChar(10)
  issuedAt      DateTime @map("issued_at") @db.Timestamptz
