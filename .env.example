NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://erp:erp_local_only@localhost:5432/erp?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
LOG_LEVEL=info
SWAGGER_ENABLED=true
ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
BOOTSTRAP_COMPANY_NAME=Empresa de Desenvolvimento
BOOTSTRAP_COMPANY_TAX_ID=00000000000191
BOOTSTRAP_BRANCH_TAX_ID=00000000000191
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Replace!WithSecure123
BOOTSTRAP_TIMEZONE=America/Fortaleza
BARCODE_LOOKUP_PROVIDER=openfoodfacts
OPENFOODFACTS_USER_AGENT=ERP-Hibrido/0.1 (contato@example.com)
BARCODE_LOOKUP_TIMEOUT_MS=5000
CUSTOMER_ENRICHMENT_PROVIDER=brasilapi
BRASILAPI_USER_AGENT=ERP-Hibrido/0.1 (contato@example.com)
BRASILAPI_TIMEOUT_MS=5000
IMPORT_STORAGE_PATH=storage/imports
PUBLIC_WEB_URL=http://localhost:5173
NFCE_GATEWAY_URL=
NFCE_GATEWAY_TOKEN=
# Os valores abaixo são exemplos de referências. Use secrets reais apenas no ambiente.
WHATSAPP_GATEWAY_API_KEY_TENANT=replace_in_secret_manager
WHATSAPP_GATEWAY_WEBHOOK_SECRET_TENANT=replace_with_random_shared_secret
