{
  "name": "erp-hibrido",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20.17.0" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @erp/api prisma:generate",
    "db:migrate": "pnpm --filter @erp/api prisma:migrate",
    "windows:installers": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows/Build-Installers.ps1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.18.1"
  }
}
